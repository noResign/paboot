{
  "name": "paboot-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "paboot desktop client (Electron + React).",
  "license": "Apache-2.0",
  "author": "noResign",
  "homepage": "https://github.com/noResign/paboot#readme",
  "main": "out/main/index.js",
  "desktopName": "paboot.desktop",
  "scripts": {
    "postinstall": "install-electron",
    "predev": "node ../daemon/node_modules/typescript/bin/tsc -p ../daemon/tsconfig.json",
    "dev": "electron-vite dev",
    "prebuild": "node ../daemon/node_modules/typescript/bin/tsc -p ../daemon/tsconfig.json && node scripts/bundle-daemon.mjs",
    "bundle:daemon": "node scripts/bundle-daemon.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:windows": "pnpm build && electron-builder --win",
    "clean": "rm -rf out release && echo 'cleaned: out/ release/'",
    "clean:all": "rm -rf out release node_modules && echo 'cleaned: out/ release/ node_modules/ — run pnpm install next'",
    "clean:cache": "rm -rf ~/.cache/electron ~/.cache/electron-builder && echo 'cleaned: ~/.cache/electron ~/.cache/electron-builder'"
  },
  "devDependencies": {
    "@noresign/paboot": "link:../daemon",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.8"
  }
}
