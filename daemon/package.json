{
  "name": "@noresign/paboot",
  "version": "1.8.6",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "One client for all your agents — run the agents on your machine headless and stream normalized events over HTTP/SSE: session resume, tool-call approval, multi-agent runs.",
  "license": "Apache-2.0",
  "author": "noResign",
  "homepage": "https://github.com/noResign/paboot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noResign/paboot.git",
    "directory": "daemon"
  },
  "bugs": "https://github.com/noResign/paboot/issues",
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "headless",
    "sse",
    "daemon",
    "self-hosted"
  ],
  "bin": {
    "paboot": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    ".env.example"
  ],
  "exports": {
    "./protocol": {
      "types": "./dist/types/api.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist && echo 'cleaned: dist/'",
    "clean:all": "rm -rf dist node_modules && echo 'cleaned: dist/ node_modules/ — run pnpm install next'",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.9"
  },
  "dependencies": {
    "cron-parser": "^5.10.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
}
